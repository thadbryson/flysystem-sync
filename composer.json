{
    "name": "thadbryson/flysystem-sync",
    "description": "Flysystem wrapper to sync directories.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Thad Bryson",
            "email": "thadbry@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "league/flysystem": "^3",
        "illuminate/collections": "^11"
    },
    "require-dev": {
        "codeception/codeception": "^5.1.2",
        "codeception/module-asserts": "^3.0.0",
        "codeception/module-phpbrowser": "*"
    },
    "autoload": {
        "psr-4": {
            "TCB\\FlysystemSync\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "prefer-stable": true
}